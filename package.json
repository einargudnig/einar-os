{
  "name": "einar-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "dev:all": "concurrently \"convex dev\" \"astro dev\"",
    "build": "npm run og && astro build",
    "preview": "npm run build && wrangler dev --config dist/server/wrangler.json",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "lint": "oxlint",
    "typecheck": "astro check",
    "check": "oxlint && astro check",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "convex:dev": "convex dev",
    "quotes": "cd tools/quotes-tui && npm run start",
    "og": "node scripts/generate-og.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14",
    "@astrojs/mdx": "^7",
    "@astrojs/react": "^6",
    "@astrojs/sitemap": "^3",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4",
    "astro": "^7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.31.5",
    "dotenv": "^17.2.3",
    "lightningcss": "^1.30.2",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^5.15.0",
    "postgres": "^3.4.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "^1.3.6",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "concurrently": "^9.2.1",
    "express": "^5.1.0",
    "gray-matter": "^4.0.3",
    "open": "^10.2.0",
    "oxfmt": "^0.20.0",
    "oxlint": "^1.53.0",
    "satori": "^0.29.0",
    "shiki": "^3.13.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
