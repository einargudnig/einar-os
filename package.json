{
  "name": "einar-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "dev:all": "concurrently \"convex dev\" \"astro dev\"",
    "build": "astro build",
    "preview": "astro build && wrangler dev --config dist/server/wrangler.json",
    "deploy": "astro build && wrangler deploy --config dist/server/wrangler.json",
    "lint": "oxlint",
    "typecheck": "tsgo --noEmit",
    "check": "oxlint && tsgo --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "convex:dev": "convex dev",
    "quotes": "cd tools/quotes-tui && npm run start"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14",
    "@astrojs/mdx": "^7",
    "@astrojs/react": "^6",
    "@astrojs/sitemap": "^3",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "astro": "^7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.31.5",
    "dotenv": "^17.2.3",
    "lightningcss": "^1.30.2",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^5.15.0",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-wrap-balancer": "^1.1.1",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@shikijs/rehype": "^3.13.0",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.3.6",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "concurrently": "^9.2.1",
    "express": "^5.1.0",
    "open": "^10.2.0",
    "oxfmt": "^0.20.0",
    "oxlint": "^1.53.0",
    "shiki": "^3.13.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "velite": "^0.3.0"
  }
