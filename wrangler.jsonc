{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "einar-os",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],

  // main/assets are injected by @astrojs/cloudflare into
  // dist/server/wrangler.json at build time — deploy with that config.
  "observability": {
    "enabled": true
  }
}
