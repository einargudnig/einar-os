# Contact form (/api/contact → components/hire-me.tsx)
# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Defaults to einargudnig@gmail.com.
CONTACT_TO_EMAIL=

# Optional. Defaults to onboarding@resend.dev, which only delivers to the
# address owning the Resend account. Point this at a verified domain sender
# (e.g. hello@einargudni.com) once the domain is verified in Resend.
CONTACT_FROM_EMAIL=

# Live Whoop numbers on /. Without these the site serves the committed snapshot
# in data/whoop/latest.json. The token is the read key life-os issues for this
# site specifically, so revoking it never disturbs my own devices' key.
LIFEOS_API_URL=
LIFEOS_WEB_TOKEN=
