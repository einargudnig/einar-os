{
  "$schema": "https://oxc.rs/schema/.oxlintrc.json",
  "plugins": [
    "react",
    "nextjs",
    "typescript",
    "import"
  ],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }],
    "react/react-in-jsx-scope": "off"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  }
}
