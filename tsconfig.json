{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["astro/client"],
    "allowJs": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "node_modules",
    "dist",
    ".open-next",
    ".wrangler",
    ".velite",
    "tools",
    "convex-export",
    "convex-export-data",
    "convex-export-new"
  ]
}
