{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "paths": {
      "@/*": ["./*"]
    },
    "allowJs": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "components/**/*", "lib/**/*", "scripts/**/*", "convex/**/*", "*.ts"],
  "exclude": ["node_modules", "tools", "dist", ".velite"]
}
