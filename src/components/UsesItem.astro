---
// Astro port of components/uses-item.tsx. Written as markup rather than
// wrapping the React version so <ul> keeps <li> as its direct children —
// an intervening <astro-slot> would break `divide-y`.

interface Props {
  name: string;
  href?: string;
  description?: string;
}

const { name, href, description } = Astro.props;
const isExternal = href?.startsWith("http");
---

{
  href ? (
    <li>
      <a
        href={href}
        {...(isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {})}
        class="group flex py-2 px-2 -mx-2 rounded-md transition-colors hover:bg-muted/50"
      >
        <div class="flex items-center justify-between gap-2 w-full">
          <div class="flex items-baseline gap-2 min-w-0">
            <span class="group-hover:text-brand transition-colors" set:html={name} />
            {description && (
              <span class="text-sm text-muted-foreground truncate hidden sm:inline">
                {description}
              </span>
            )}
          </div>
          <svg
            class="h-3.5 w-3.5 shrink-0 text-muted-foreground opacity-0 group-hover:opacity-100 transition-opacity"
            viewBox="0 0 15 15"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M3.64645 11.3536C3.45118 11.1583 3.45118 10.8417 3.64645 10.6465L10.2929 4L6 4C5.72386 4 5.5 3.77614 5.5 3.5C5.5 3.22386 5.72386 3 6 3L11.5 3C11.6326 3 11.7598 3.05268 11.8536 3.14645C11.9473 3.24022 12 3.36739 12 3.5L12 9.00001C12 9.27615 11.7761 9.50001 11.5 9.50001C11.2239 9.50001 11 9.27615 11 9.00001V4.70711L4.35355 11.3536C4.15829 11.5488 3.84171 11.5488 3.64645 11.3536Z"
              fill="currentColor"
              fill-rule="evenodd"
              clip-rule="evenodd"
            />
          </svg>
        </div>
      </a>
    </li>
  ) : (
    <li class="py-2 px-2 -mx-2">
      <div class="flex items-center justify-between gap-2">
        <div class="flex items-baseline gap-2 min-w-0">
          <span set:html={name} />
          {description && (
            <span class="text-sm text-muted-foreground truncate hidden sm:inline">
              {description}
            </span>
          )}
        </div>
      </div>
    </li>
  )
}
