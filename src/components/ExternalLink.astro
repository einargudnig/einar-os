---
// Astro twin of components/blog/external-link.tsx. Used from .astro pages so
// inline links don't pick up an <astro-slot> wrapper mid-sentence; the React
// version stays for MDX.
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="inline-flex items-center text-muted-foreground hover:text-brand transition-colors group"
>
  <span
    class="underline underline-offset-2 decoration-border hover:decoration-brand transition-colors"
    ><slot /></span
  >
  <svg
    class="ml-1 h-3 w-3 opacity-60 group-hover:opacity-100 group-hover:scale-110 transition-[opacity,transform] duration-150 ease-[var(--ease-out)]"
    viewBox="0 0 15 15"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M3.64645 11.3536C3.45118 11.1583 3.45118 10.8417 3.64645 10.6465L10.2929 4L6 4C5.72386 4 5.5 3.77614 5.5 3.5C5.5 3.22386 5.72386 3 6 3L11.5 3C11.6326 3 11.7598 3.05268 11.8536 3.14645C11.9473 3.24022 12 3.36739 12 3.5L12 9.00001C12 9.27615 11.7761 9.50001 11.5 9.50001C11.2239 9.50001 11 9.27615 11 9.00001V4.70711L4.35355 11.3536C4.15829 11.5488 3.84171 11.5488 3.64645 11.3536Z"
      fill="currentColor"
      fill-rule="evenodd"
      clip-rule="evenodd"></path>
  </svg>
</a>
