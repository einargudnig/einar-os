---
// No client directive: these render to static SVG at build time.
import { Github, Mail, Twitter } from "lucide-react";
import { KeyboardHint } from "@/components/keyboard-hint";
import { cn } from "@/lib/utils";

const navItems = {
  "/": { name: "home" },
  "/uses": { name: "uses" },
  "/blog": { name: "blog" },
};

// Was usePathname() in a client component; the whole nav is static now.
const pathname = Astro.url.pathname;
const isActive = (path: string) =>
  path === "/" ? pathname === "/" : pathname.startsWith(path);
---

<nav class="mx-auto w-full space-y-8 print:space-y-6">
  <aside class="mb-16 tracking-tight">
    <div class="lg:sticky lg:top-20">
      <nav class="pb-4 border-b border-border/50" id="nav">
        <div class="flex justify-between items-center">
          <div class="flex items-center flex-row-reverse md:flex-row">
            <div class="flex flex-row gap-x-1">
              {
                Object.entries(navItems).map(([path, { name }]) => (
                  <a
                    href={path}
                    class={cn(
                      "transition-colors duration-200 flex align-middle relative py-2 px-3 rounded-md",
                      "after:absolute after:bottom-0 after:left-3 after:right-3 after:h-px",
                      isActive(path)
                        ? "text-foreground after:bg-foreground/60"
                        : "text-muted-foreground hover:text-brand hover:bg-muted/50 after:bg-transparent",
                    )}
                  >
                    {name}
                  </a>
                ))
              }
            </div>
          </div>
          <div class="flex items-center gap-x-3">
            <KeyboardHint client:idle />
            {/* Jumps to the contact form on the home page. The navbar is already at
                its width limit on phones, so the label collapses to a mail icon
                that sits with the social links. */}
            <a
              href="/#contact"
              class={cn(
                "hidden sm:inline-flex items-center gap-x-2 rounded-full border py-1.5 px-3",
                "text-sm transition-colors",
                "border-border/60 text-muted-foreground",
                "hover:border-brand/40 hover:bg-muted/50 hover:text-brand",
              )}
            >
              <span class="relative flex h-1.5 w-1.5">
                <span
                  class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand opacity-60 motion-reduce:hidden"
                ></span>
                <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-brand"></span>
              </span>
              work with me
            </a>
            <a
              href="/#contact"
              aria-label="Work with me"
              class="sm:hidden text-muted-foreground hover:text-brand transition-colors p-2 -m-1"
            >
              <Mail size={20} strokeWidth={1.5} />
            </a>
            <a
              href="https://github.com/einargudnig"
              class="text-muted-foreground hover:text-brand transition-colors p-2 -m-1"
            >
              <Github size={20} strokeWidth={1.5} />
            </a>
            <a
              href="https://x.com/einargudni"
              class="text-muted-foreground hover:text-brand transition-colors p-2 -m-1"
            >
              <Twitter size={20} strokeWidth={1.5} />
            </a>
          </div>
        </div>
      </nav>
    </div>
  </aside>
</nav>
