---
// Astro's Shiki has already highlighted this at build time; we only add the
// chrome the old CodeBlock drew around it. The copy button is ~10 lines of
// vanilla JS instead of shipping the Shiki runtime to the browser.
const { "data-language": language, class: className, ...rest } = Astro.props;
---

<div class="code-block relative my-6 overflow-hidden rounded-lg border border-border bg-muted/30">
  <div class="relative">
    <div class="overflow-x-auto text-sm code-with-lines">
      <pre class:list={[className, "p-4 m-0"]} {...rest}><slot /></pre>
    </div>
    {
      language && (
        <div class="absolute right-2 top-2 text-xs font-medium text-muted-foreground/60 pointer-events-none">
          {language.toUpperCase()}
        </div>
      )
    }
    <button
      type="button"
      class="copy-code absolute bottom-2 right-2 rounded bg-muted p-1.5 text-muted-foreground hover:bg-muted/80 hover:text-foreground transition-colors active:scale-[0.95]"
      aria-label="Copy code to clipboard"
    >
      <svg class="icon-copy h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path></svg>
      <svg class="icon-check hidden h-4 w-4 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
    </button>
  </div>
</div>

<style is:global>
  .code-with-lines .line {
    display: inline-block;
    width: 100%;
  }
  .code-with-lines .line::before {
    counter-increment: line;
    content: counter(line);
    display: inline-block;
    width: 2.5rem;
    margin-right: 1.5rem;
    text-align: right;
    color: rgba(127, 132, 156, 0.6);
    user-select: none;
    border-right: 1px solid rgba(127, 132, 156, 0.3);
    padding-right: 0.75rem;
  }
  .code-with-lines pre {
    counter-reset: line;
  }
</style>

<script>
  const wire = () => {
    document.querySelectorAll<HTMLButtonElement>("button.copy-code").forEach((button) => {
      if (button.dataset.wired) return;
      button.dataset.wired = "true";
      button.addEventListener("click", async () => {
        const code = button.closest(".code-block")?.querySelector("pre")?.innerText ?? "";
        await navigator.clipboard.writeText(code);
        button.querySelector(".icon-copy")?.classList.add("hidden");
        button.querySelector(".icon-check")?.classList.remove("hidden");
        setTimeout(() => {
          button.querySelector(".icon-copy")?.classList.remove("hidden");
          button.querySelector(".icon-check")?.classList.add("hidden");
        }, 2000);
      });
    });
  };

  wire();
  // ClientRouter swaps the DOM on navigation.
  document.addEventListener("astro:page-load", wire);
</script>
