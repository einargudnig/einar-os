---
// On-demand so the on-demand [slug] routes can Astro.rewrite("/404") into it.
// A prerendered route has no component instance in the SSR pipeline, which
// makes rewriting to it a 500.
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import NotFound from "../components/NotFound.astro";

Astro.response.status = 404;
---

<BaseLayout title="Not found">
  <NotFound />
</BaseLayout>
