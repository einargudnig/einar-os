---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found">
  <section class="mx-auto w-full max-w-2xl py-24 text-center">
    <h1 class="font-bold text-3xl tracking-tight">404</h1>
    <p class="mt-3 text-muted-foreground">This page doesn't exist.</p>
    <a
      href="/"
      class="mt-8 inline-block text-sm font-mono text-muted-foreground hover:text-brand transition-colors"
    >
      &larr; back home
    </a>
  </section>
</BaseLayout>
