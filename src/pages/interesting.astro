---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { mdxComponents } from "../components/mdx-components";
import { formatBlogDate } from "@/lib/utils";

const interesting = await getCollection("interesting");
const sorted = interesting.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const entries = await Promise.all(
  sorted.map(async (item) => ({ item, Content: (await render(item)).Content })),
);

const isoDate = (date: Date) => date.toISOString().slice(0, 10);
---

<BaseLayout
  title="Interesting"
  description="A collection of whatever I find genuinely interesting."
>
  <section class="mx-auto w-full max-w-2xl space-y-10 print:space-y-8 mb-8">
    <header>
      <h1 class="font-bold text-3xl tracking-tight mb-2">Interesting</h1>
      <p class="text-muted-foreground">
        Whatever is interesting. Facts, links, videos, thoughts — anything
        that made me curious.
      </p>
    </header>

    <div class="divide-y divide-border/50 stagger-list">
      {
        entries.map(({ item, Content }) => (
          <div class="py-8 first:pt-0">
            <article class="prose dark:prose-invert mb-3 mdx-content">
              <header class="mb-4">
                <h2 class="text-xl font-semibold">{item.data.title}</h2>
                <div class="text-sm text-muted-foreground flex items-center gap-2">
                  <time class="font-mono tabular-nums" datetime={isoDate(item.data.date)}>
                    {formatBlogDate(item.data.date)}
                  </time>
                  {item.data.tags && item.data.tags.length > 0 && (
                    <>
                      <span>·</span>
                      {item.data.tags.map((tag) => (
                        <span class="text-brand/70 font-mono">{tag}</span>
                      ))}
                    </>
                  )}
                </div>
              </header>
              <Content components={mdxComponents} />
              {item.data.url && (
                <a
                  href={item.data.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group inline-flex items-center gap-1 text-sm text-brand no-underline hover:underline"
                >
                  source
                  <svg
                    class="h-3.5 w-3.5 transition-transform duration-150 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                    viewBox="0 0 15 15"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M3.64645 11.3536C3.45118 11.1583 3.45118 10.8417 3.64645 10.6465L10.2929 4L6 4C5.72386 4 5.5 3.77614 5.5 3.5C5.5 3.22386 5.72386 3 6 3L11.5 3C11.6326 3 11.7598 3.05268 11.8536 3.14645C11.9473 3.24022 12 3.36739 12 3.5L12 9.00001C12 9.27615 11.7761 9.50001 11.5 9.50001C11.2239 9.50001 11 9.27615 11 9.00001V4.70711L4.35355 11.3536C4.15829 11.5488 3.84171 11.5488 3.64645 11.3536Z"
                      fill="currentColor"
                      fill-rule="evenodd"
                      clip-rule="evenodd"
                    />
                  </svg>
                </a>
              )}
            </article>
          </div>
        ))
      }
      {
        entries.length === 0 && (
          <p class="text-muted-foreground text-sm py-8">Nothing here yet.</p>
        )
      }
    </div>
  </section>
</BaseLayout>
