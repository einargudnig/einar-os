---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { mdxComponents } from "../components/mdx-components";
import { NotesTabs } from "@/components/notes-tabs";
import { buttonVariants } from "@/components/ui/button";
import { cn, formatBlogDate } from "@/lib/utils";

const learnings = await getCollection("learnings");
const links = await getCollection("links");

const sortedLearnings = learnings.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const sortedLinks = links.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const noteEntries = await Promise.all(
  sortedLearnings.map(async (item) => ({ item, Content: (await render(item)).Content })),
);

const isoDate = (date: Date) => date.toISOString().slice(0, 10);
---

<BaseLayout title="Notes" description="Quick thoughts and ideas" ogImage="notes">
  <section class="mx-auto w-full max-w-2xl space-y-10 print:space-y-8 mb-8">
    <h1 class="font-bold text-3xl tracking-tight mb-5">Notes</h1>

    {/* Named slots become props on the React island; both panels are rendered
        to HTML on the server and the island only toggles between them. */}
    <NotesTabs client:load>
      <div slot="notes" class="divide-y divide-border/50 stagger-list">
        {
          noteEntries.map(({ item, Content }) => (
            <div class="py-8 first:pt-0">
              <article class="prose dark:prose-invert mb-3 mdx-content">
                <header class="mb-4">
                  <h2 class="text-xl font-semibold">{item.data.title}</h2>
                  <div class="text-sm text-muted-foreground flex items-center gap-2">
                    <span class="text-brand font-mono">{item.data.topic}</span>
                    <span>·</span>
                    <time class="font-mono tabular-nums" datetime={isoDate(item.data.date)}>
                      {formatBlogDate(item.data.date)}
                    </time>
                    {item.data.deepDiveSlug && (
                      <a href={`/deep-dive/${item.data.deepDiveSlug}`} class="no-underline">
                        <span class={cn(buttonVariants({ size: "sm", variant: "outline" }))}>
                          Deep Dive
                        </span>
                      </a>
                    )}
                  </div>
                </header>
                <Content components={mdxComponents} />
              </article>
            </div>
          ))
        }
      </div>

      <div slot="links" class="divide-y divide-border/50 stagger-list">
        {
          sortedLinks.map((item) => (
            <div class="py-6 first:pt-0">
              <a href={item.data.url} target="_blank" rel="noopener noreferrer" class="group block">
                <div class="flex items-start justify-between gap-3">
                  <div class="space-y-1.5">
                    <h2 class="text-base font-semibold group-hover:text-brand transition-colors">
                      {item.data.title}
                      <svg
                        class="inline-block ml-1.5 h-3.5 w-3.5 opacity-0 -translate-y-0.5 group-hover:opacity-60 group-hover:translate-y-0 transition-[opacity,transform] duration-150"
                        viewBox="0 0 15 15"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          d="M3.64645 11.3536C3.45118 11.1583 3.45118 10.8417 3.64645 10.6465L10.2929 4L6 4C5.72386 4 5.5 3.77614 5.5 3.5C5.5 3.22386 5.72386 3 6 3L11.5 3C11.6326 3 11.7598 3.05268 11.8536 3.14645C11.9473 3.24022 12 3.36739 12 3.5L12 9.00001C12 9.27615 11.7761 9.50001 11.5 9.50001C11.2239 9.50001 11 9.27615 11 9.00001V4.70711L4.35355 11.3536C4.15829 11.5488 3.84171 11.5488 3.64645 11.3536Z"
                          fill="currentColor"
                          fill-rule="evenodd"
                          clip-rule="evenodd"
                        />
                      </svg>
                    </h2>
                    <p class="text-sm text-muted-foreground leading-relaxed">
                      {item.data.description}
                    </p>
                    <div class="flex items-center gap-2 text-xs text-muted-foreground/70">
                      <time class="font-mono tabular-nums" datetime={isoDate(item.data.date)}>
                        {formatBlogDate(item.data.date)}
                      </time>
                      {item.data.tags && item.data.tags.length > 0 && (
                        <>
                          <span>·</span>
                          {item.data.tags.map((tag) => (
                            <span class="text-brand/70 font-mono">{tag}</span>
                          ))}
                        </>
                      )}
                    </div>
                  </div>
                </div>
              </a>
            </div>
          ))
        }
        {sortedLinks.length === 0 && <p class="text-muted-foreground text-sm py-8">No links yet.</p>}
      </div>
    </NotesTabs>
  </section>
</BaseLayout>
