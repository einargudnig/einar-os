---
// On-demand for the same reason as blog posts: Accept: text/markdown.
export const prerender = false;

import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { mdxComponents } from "../../components/mdx-components";
import { Alert, AlertDescription, AlertTitle } from "@/components/ui/alert";
import { formatBlogDate } from "@/lib/utils";

const { slug } = Astro.params;

const deepDives = await getCollection("deepDives");
const dive = deepDives.find((entry) => entry.data.slug === slug);

if (!dive) {
  return Astro.rewrite("/404");
}

const { Content } = await render(dive);
---

<BaseLayout title={dive.data.title} ogImage={`deep-dive-${dive.data.slug}`}>
  <section class="mx-auto w-full max-w-2xl space-y-8 print:space-y-6">
    <div>
      <h1
        class="font-bold text-3xl md:text-4xl tracking-tight max-w-[650px] leading-tight text-balance"
      >
        {dive.data.title}
      </h1>
      <div class="flex items-center gap-3 mt-4 mb-8">
        <div class="font-mono text-sm text-muted-foreground tabular-nums tracking-tighter">
          {formatBlogDate(dive.data.date)}
        </div>
        <div class="h-px flex-1 bg-border/50"></div>
      </div>
    </div>

    {
      dive.data.draft && (
        <div class="mb-6">
          <Alert>
            <AlertTitle>Under construction</AlertTitle>
            <AlertDescription>This post is not finished!</AlertDescription>
          </Alert>
        </div>
      )
    }

    <article class="prose dark:prose-invert max-w-[65ch] leading-relaxed mdx-content">
      <Content components={mdxComponents} />
    </article>
  </section>
</BaseLayout>
