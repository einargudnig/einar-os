---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import "../styles/globals.css";

import Navbar from "../components/Navbar.astro";
import { KeyboardNav } from "@/components/keyboard-nav";
import { WebMCP } from "@/components/web-mcp";
import { BirthdayConfetti } from "@/components/birthday-confetti";

interface Props {
  title?: string;
  description?: string;
  /** Basename in public/og, generated by scripts/generate-og.mjs. */
  ogImage?: string;
}

const {
  title = "Einar Gudni",
  description = "My home on the web 🏡",
  ogImage = "home",
} = Astro.props;
const year = new Date().getFullYear();

// Next derived these from the opengraph-image file convention; now they're
// explicit.
const ogImageUrl = new URL(`/og/${ogImage}.png`, Astro.site);
// build.format: "file" prerenders to /blog.html, so Astro.url.pathname carries a
// .html suffix that the served URL never has — /blog.html only 307s to /blog.
// Strip it, or every prerendered page advertises a redirect as its canonical.
const canonical = new URL(
  Astro.url.pathname.replace(/(?:\/index)?\.html$/, "") || "/",
  Astro.site,
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Byte-identical to the file the Next site shipped: PNG data behind an
        .ico extension. Left as-is for parity — no `type`, so browsers sniff. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Einar Gudni" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />

    <Font cssVariable="--font-geist-sans" preload />
    <Font cssVariable="--font-geist-mono" />

    {/* Applied before paint so the dark default never flashes. Reuses the
        `theme` key next-themes wrote, so existing visitors keep their choice.

        Re-applied on astro:after-swap because ClientRouter replaces the <html>
        element's attributes with the incoming document's, and that document has
        no class="dark" — the class only ever exists at runtime. Without this you
        land dark, click one link, and stay light for the rest of the session.
        The event fires before the new page paints, so there's still no flash. */}
    <script is:inline>
      function applyTheme() {
        const stored = localStorage.getItem("theme");
        const theme = stored === "light" || stored === "dark"
          ? stored
          : stored === "system"
            ? (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark")
            : "dark";
        document.documentElement.classList.toggle("dark", theme === "dark");
        document.documentElement.style.colorScheme = theme;
      }
      applyTheme();
      // document survives the swap, so registering once on first load is enough.
      document.addEventListener("astro:after-swap", applyTheme);
    </script>

    <ClientRouter />
  </head>

  <body class="antialiased mb-10 lg:mx-auto">
    <WebMCP client:idle />
    <BirthdayConfetti client:idle />

    <main
      class="relative mx-auto mt-8 flex min-h-[calc(100dvh-4.5rem)] max-w-4xl flex-col overflow-auto px-6 md:px-8"
    >
      <Navbar />
      <div class="flex-1"><slot /></div>
      <footer
        class="mt-16 mb-8 border-t border-border/50 pt-6 flex items-center justify-between text-xs text-muted-foreground font-mono"
      >
        <span>don't half ass it</span>
        <span class="tabular-nums">{year}</span>
      </footer>
      <KeyboardNav client:idle />
    </main>
  </body>
</html>
